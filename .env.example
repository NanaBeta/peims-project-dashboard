# Enterprise API only; never commit secrets, DSNs or tokens.
# PEIMS_DATABASE_URL=postgresql+psycopg://peims_user:REPLACE@db.example.com:5432/peims?sslmode=require
# PEIMS_OIDC_ISSUER=https://your-identity-provider.example.com/
# PEIMS_OIDC_AUDIENCE=api://peims-example
# PEIMS_OIDC_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json

# v0.8.1 enterprise browser console (confidential OAuth authorization code + PKCE)
# Configure only in the private API deployment, NEVER in the public Streamlit app.
# PEIMS_CONSOLE_ORIGIN=https://enterprise.example.com
# PEIMS_CONSOLE_AUTHORIZE_URL=https://your-idp.example.com/oauth2/authorize
# PEIMS_CONSOLE_TOKEN_URL=https://your-idp.example.com/oauth2/token
# PEIMS_CONSOLE_CLIENT_ID=confidential-web-client-id
# PEIMS_CONSOLE_CLIENT_SECRET=GENERATE_AND_STORE_IN_SECRETS_MANAGER
# PEIMS_CONSOLE_COOKIE_KEY=GENERATE_A_FERNET_KEY_AND_KEEP_PRIVATE
